{
  "name": "@jarvis/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Local-Live-1 desktop shell (Electron) for the local Jarvis voice agent UI",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "ai.jarvis.desktop",
    "productName": "Local-Live-1",
    "files": ["main.js", "preload.js"],
    "mac": {
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Local-Live-1 uses the microphone for voice input."
      }
    },
    "linux": { "target": "AppImage" },
    "win": { "target": "nsis" }
  }
}
